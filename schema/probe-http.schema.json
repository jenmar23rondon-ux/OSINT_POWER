{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "probe_http": {
      "type": "boolean",
      "const": true
    },
    "authorized": {
      "type": "boolean",
      "const": true
    },
    "maxTargets": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "required": [
    "target",
    "probe_http",
    "authorized",
    "maxTargets"
  ],
  "additionalProperties": false
}
