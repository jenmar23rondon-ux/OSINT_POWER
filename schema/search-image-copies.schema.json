{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 2796204
    },
    "candidates": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"
          },
          "data_base64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 2796204
          },
          "source_url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          }
        },
        "required": [
          "id",
          "data_base64"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "query_base64",
    "candidates"
  ],
  "additionalProperties": false
}
