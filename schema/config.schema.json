{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "domains": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeDomains": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ips": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emails": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "usernames": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$"
          }
        },
        "documents": {
          "default": [],
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "people": {
          "default": [],
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "companyDomain": {
                "type": "string"
              },
              "aliases": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$"
                }
              }
            },
            "required": [
              "name",
              "companyDomain",
              "aliases"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "domains",
        "excludeDomains",
        "ips",
        "emails",
        "usernames",
        "documents",
        "people"
      ],
      "additionalProperties": false
    },
    "network": {
      "default": false,
      "type": "boolean"
    },
    "active": {
      "default": false,
      "type": "boolean"
    },
    "webhookAllowedUrls": {
      "default": [],
      "maxItems": 25,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "enabledAdapters": {
      "default": [
        "crtsh"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "crtsh",
          "certspotter",
          "wayback",
          "subfinder",
          "amass",
          "dnsx",
          "httpx",
          "naabu",
          "hibp",
          "sherlock",
          "theharvester",
          "mx",
          "rdap",
          "routing",
          "github-profile"
        ]
      }
    },
    "collectors": {
      "type": "object",
      "properties": {
        "sherlockSites": {
          "default": [
            "GitHub"
          ],
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "GitHub",
              "GitLab",
              "Keybase"
            ]
          }
        },
        "harvesterSources": {
          "default": [
            "crtsh"
          ],
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "crtsh",
              "certspotter"
            ]
          }
        },
        "usernameSuffixes": {
          "default": [
            "1",
            "01"
          ],
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{1,2}$"
          }
        }
      },
      "required": [
        "sherlockSites",
        "harvesterSources",
        "usernameSuffixes"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "timeoutMs": {
          "default": 20000,
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "maxBytes": {
          "default": 2000000,
          "type": "integer",
          "minimum": 100,
          "maximum": 10000000
        },
        "maxRecords": {
          "default": 2000,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "minIntervalMs": {
          "default": 1500,
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "attempts": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cacheTtlSeconds": {
          "default": 3600,
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "ports": {
          "default": [
            80,
            443
          ],
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "requestRate": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "providers": {
          "type": "object",
          "properties": {
            "defaults": {
              "type": "object",
              "properties": {
                "maxRequests": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "windowMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 86400000
                },
                "minIntervalMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                },
                "failureThreshold": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "cooldownMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 86400000
                }
              },
              "required": [
                "maxRequests",
                "windowMs",
                "minIntervalMs",
                "failureThreshold",
                "cooldownMs"
              ],
              "additionalProperties": false
            },
            "overrides": {
              "default": {
                "api.github.com": {
                  "maxRequests": 60,
                  "windowMs": 3600000
                },
                "haveibeenpwned.com": {
                  "maxRequests": 10,
                  "windowMs": 60000
                }
              },
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z0-9.:-]{1,100}$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "maxRequests": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "windowMs": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 86400000
                  },
                  "minIntervalMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 60000
                  },
                  "failureThreshold": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "cooldownMs": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 86400000
                  }
                },
                "additionalProperties": false
              }
            },
            "maxWaitMs": {
              "default": 5000,
              "type": "integer",
              "minimum": 0,
              "maximum": 60000
            }
          },
          "required": [
            "defaults",
            "overrides",
            "maxWaitMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "timeoutMs",
        "maxBytes",
        "maxRecords",
        "minIntervalMs",
        "attempts",
        "cacheTtlSeconds",
        "ports",
        "requestRate",
        "providers"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "scope",
    "network",
    "active",
    "webhookAllowedUrls",
    "enabledAdapters",
    "collectors",
    "limits"
  ],
  "additionalProperties": false
}
