{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "company_domain": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "employee",
        "role",
        "technology",
        "place",
        "profile",
        "email",
        "job"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "person": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "default": "observed",
      "type": "string",
      "enum": [
        "observed",
        "inferred"
      ]
    },
    "place_kind": {
      "type": "string",
      "const": "public_office"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "company_domain",
    "kind",
    "value",
    "source_url",
    "status",
    "timestamp"
  ],
  "additionalProperties": false
}
