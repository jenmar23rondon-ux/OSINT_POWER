{
  "name": "osint-power",
  "version": "0.1.0",
  "description": "Evidence-first OSINT workspace with a bounded CLI and MCP server",
  "type": "module",
  "private": true,
  "overrides": {
    "minimatch": "11.0.5"
  },
  "license": "MIT",
  "author": "Jenmar Rondon",
  "repository": "github:jenmar23rondon-ux/OSINT_POWER",
  "engines": {
    "node": ">=24.14.0"
  },
  "bin": {
    "osint-power": "src/cli.js",
    "osint-power-mcp": "src/mcp.js"
