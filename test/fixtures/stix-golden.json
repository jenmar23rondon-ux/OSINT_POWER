    {
      "type": "note",
      "spec_version": "2.1",
      "id": "note--24b61972-b661-5cf8-80a2-dff75cf3cf03",
      "created": "2026-06-01T00:00:00.000Z",
      "modified": "2026-06-02T00:00:00.000Z",
      "created_by_ref": "identity--fcedc5bf-1f52-5351-88e3-6e6e1546f903",
      "abstract": "Export limitations",
      "content": "Export reads stored evidence. It does not collect, review, monitor, or change phishing state. Out-of-scope entities are omitted. A suspected lookalike is included only when its protected apex is in scope, and only as a suspected indicator. Suspected leads and candidate links stay suspected or candidate. An analyst accept is an opinion, not a confirmation. Indicator confidence rescales the stored heuristic and is capped at 85. It is not a calibrated probability. Identifiers are UUIDv5 values from stored content. The bundle is deterministic for the same database and filters, and it is not a signed attestation. Entity types without a STIX 2.1 cyber-observable are notes. Certificate objects contain stored names, issuers and validity only; a certificate-transparency record id is not a serial number. At most 200 entities and 10 observations per entity are exported. A truncated bundle is a valid subset, not the whole workspace. With no investigation filter and a review filter of any or unreviewed, the configured apex may be added as a domain-name. That object is scope context, not a new sighting.",
      "authors": ["OSINT POWER"],
      "object_refs": ["identity--fbdb57af-5367-53a1-afa7-b838ffc8f03a"]
    },
    {
      "type": "note",
      "spec_version": "2.1",
      "id": "note--36251f5e-f066-5b2e-9142-c32d5a6184e5",
      "created": "2026-06-01T00:00:00.000Z",
      "modified": "2026-06-01T00:00:00.000Z",
      "created_by_ref": "identity--fcedc5bf-1f52-5351-88e3-6e6e1546f903",
      "abstract": "Stored username",
      "content": "Stored username is a note because STIX 2.1 has no cyber-observable for this type. Value: ops. This is not a confirmation of identity, ownership, or impact.",
      "authors": ["OSINT POWER"],
      "object_refs": ["identity--fbdb57af-5367-53a1-afa7-b838ffc8f03a"]
    },
    {
